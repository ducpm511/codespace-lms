# === CodeSpace LMS — biến môi trường mẫu (GIÁ TRỊ GIẢ, không commit .env thật) ===

# --- App ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5432/lms?schema=public

# --- Redis (BullMQ queue + cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=replace_me_dev_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_dev_refresh_secret
JWT_REFRESH_TTL=30d

# --- Storage: private files (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=fake_account_id
R2_ACCESS_KEY_ID=fake_access_key
R2_SECRET_ACCESS_KEY=fake_secret_key
R2_BUCKET=lms-private
R2_ENDPOINT=https://fake_account_id.r2.cloudflarestorage.com

# --- Storage: public media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=fake_cloud
CLOUDINARY_API_KEY=fake_api_key
CLOUDINARY_API_SECRET=fake_api_secret

# --- Code runner (Judge0 / Piston self-hosted) — chốt ở P3 ---
CODE_RUNNER_URL=http://localhost:2358
CODE_RUNNER_TOKEN=fake_runner_token
