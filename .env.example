# === CodeSpace LMS — biến môi trường mẫu (GIÁ TRỊ GIẢ, không commit .env thật) ===
#
# API validate toàn bộ khối này lúc boot (apps/api/src/config/env.validation.ts):
# thiếu hoặc sai giá trị -> API CHẾT ngay kèm danh sách vấn đề, không chạy nửa vời.

# --- App ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
# Bắt buộc khi NODE_ENV=production. Production web + API cùng origin qua Caddy.
WEB_ORIGIN=http://localhost:5173
# Trần rate limit chung cho mọi route (lượt/phút/IP). /auth/login và /auth/refresh siết riêng
# 5 lượt/phút, khoá theo (IP, email) và theo refresh token — xem common/throttling/auth-throttle.ts.
RATE_LIMIT_PER_MINUTE=600

# --- Database (PostgreSQL) ---
# Cổng 5433: docker-compose.yml map 5433 host -> 5432 container (né PostgreSQL cài sẵn trên máy).
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5433/lms?schema=public

# --- Auth (JWT) ---
# Ở production: mỗi secret tối thiểu 32 ký tự và hai secret phải KHÁC nhau.
# Sinh secret thật:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_dev_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_dev_refresh_secret
JWT_REFRESH_TTL=30d

# --- Storage ---
# local      -> ghi xuống ./uploads (mặc định, dùng cho dev)
# cloudinary -> Cloudinary với resource_type=raw + type=authenticated (file KHÔNG public;
#               client vẫn tải qua GET /api/files/:id để giữ nguyên kiểm quyền ensureCanRead)
STORAGE_DRIVER=local
# Chỉ bắt buộc khi STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=fake_cloud
CLOUDINARY_API_KEY=fake_api_key
CLOUDINARY_API_SECRET=fake_api_secret

# --- Code runner (chạy code học viên) ---
# stub   -> KHÔNG chạy code thật, chỉ để dev/smoke (mặc định; bị CHẶN ở production)
# piston -> Piston self-host, cách ly network khỏi Postgres (xem docker-compose.prod.yml)
CODE_RUNNER_PROVIDER=stub
# Chỉ bắt buộc khi CODE_RUNNER_PROVIDER=piston.
CODE_RUNNER_URL=http://localhost:2000
CODE_RUNNER_TOKEN=fake_runner_token
CODE_RUNNER_PYTHON_VERSION=3.12.0
CODE_RUNNER_STDOUT_LIMIT_BYTES=65536

# --- Hàng đợi chấm bài ---
# inline -> chấm ngay trong request, KHÔNG cần Redis (mặc định; cấu hình chạy thật trên VPS 2 GB).
#           Đánh đổi: mất retry tự động — chấm lỗi thì học viên nộp lại.
# bull   -> BullMQ qua Redis (cần REDIS_URL). Chỉ bật ở dev khi cần test đường bull.
CODE_QUEUE_DRIVER=inline
# Chỉ bắt buộc khi CODE_QUEUE_DRIVER=bull. Cổng 6380: compose map 6380 host -> 6379 container.
REDIS_URL=redis://localhost:6380

# --- Seed dữ liệu ban đầu (packages/database/prisma/seed.cjs) ---
# Đặt cả EMAIL lẫn PASSWORD để seed tạo super_admin đầu tiên; bỏ trống thì seed bỏ qua bước này.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_me_dev_admin_password
SEED_ADMIN_NAME=System Admin

# ═══════════════════════════════════════════════════════════════════════════
# CHỈ DÙNG CHO PRODUCTION (.env.production trên VPS) — dev bỏ qua khối này.
# docker-compose.prod.yml đọc trực tiếp mấy biến dưới đây; thiếu là compose không chạy.
# ═══════════════════════════════════════════════════════════════════════════

# Tên miền đã trỏ A record về IP VPS. Caddy dùng nó để xin chứng chỉ Let's Encrypt.
LMS_DOMAIN=lms.example.com
# Email nhận cảnh báo chứng chỉ sắp hết hạn từ Let's Encrypt.
LMS_ACME_EMAIL=it@example.com

# Postgres chạy trong compose. compose TỰ DỰNG `DATABASE_URL` từ ba biến này
# (host `postgres`, cổng 5432 nội bộ) và ghi đè giá trị DATABASE_URL ở trên — nên
# ở production KHÔNG cần sửa DATABASE_URL bằng tay.
POSTGRES_USER=lms
POSTGRES_PASSWORD=thay_bang_openssl_rand_base64_32
POSTGRES_DB=lms
