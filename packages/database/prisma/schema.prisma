// CodeSpace LMS — Prisma schema (nguồn sự thật data). Đồng bộ với docs/DESIGN.md §4.
// Quy ước (sk-schema-conventions): id cuid, createdAt/updatedAt, UTC, Decimal cho điểm,
// enum value snake_case. Model RBAC/domain thêm dần theo phase (T0.2: Identity & RBAC).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Identity & RBAC (T0.1 + T0.2) — docs/DESIGN.md §4.1, §5.1 ===
// PBAC: guard kiểm permission.key (không kiểm role thô). Role→Permission là data.

enum UserStatus {
  invited
  active
  suspended
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  status       UserStatus @default(invited)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]

  // P1 (Course & Class)
  coursesCreated   Course[]         @relation("CourseCreatedBy")
  classesCreated   Class[]          @relation("ClassCreatedBy")
  classMemberships ClassMember[]
  lessonProgress   LessonProgress[]
  gatesActivated   LessonGate[]     @relation("GateActivatedBy")

  // P2 (Assessments)
  assignmentsCreated Assignment[] @relation("AssignmentCreatedBy")
  submissions        Submission[] @relation("SubmissionByUser")
  submissionsGraded  Submission[] @relation("SubmissionGradedBy")

  // P3 (Coding & Runner)
  codingProblemsCreated CodingProblem[]    @relation("CodingProblemCreatedBy")
  codingSubmissions     CodingSubmission[]

  // P4 (Quiz)
  quizzesCreated Quiz[]        @relation("QuizCreatedBy")
  quizAttempts   QuizAttempt[]

  // P5 (Gradebook & Certificate)
  gradeEntries       GradeEntry[]
  certificates       Certificate[] @relation("CertificateForUser")
  certificatesIssued Certificate[] @relation("CertificateIssuedBy")
  auditLogs          AuditLog[]    @relation("AuditLogActor")

  // P6 (Gamification, Notifications, Storage, Discussion)
  notifications Notification[]  @relation("NotificationForUser")
  xpEvents      XpEvent[]
  streak        UserStreak?
  userBadges    UserBadge[]
  badgesAwarded UserBadge[]     @relation("UserBadgeAwardedBy") // P10: huy hiệu GV trao tay
  files         File[]          @relation("FileOwner")
  comments      LessonComment[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // super_admin, admin, instructor, teaching_assistant, student, ...
  name        String
  description String?
  isSystem    Boolean  @default(false) // role hệ thống: không cho xóa
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // "<resource>.<action>", vd course.publish, grade.write
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Gán role cho user. classId != null => role có phạm vi trong 1 lớp (vd TA của lớp X).
// classId hiện là soft-ref (Class model thêm ở P1) — sẽ gắn @relation khi có Class.
// Lưu ý NULL: (userId, roleId, NULL) không bị @@unique chặn trùng ở Postgres → guard idempotent ở service.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  classId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, classId])
  @@index([roleId])
  @@index([classId])
  @@map("user_roles")
}

// Refresh token lưu server-side (hash), xoay vòng khi refresh. KHÔNG lộ token thô ra client.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// === Course & Content (T1.0) — docs/DESIGN.md §4.2 ===

enum CourseLanguage {
  scratch
  python
  other
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  draft
  published
  archived
}

enum LessonType {
  video
  article
  interactive
  coding
  quiz
  assignment
}

// P7 — loại activity trong một bài học (1 lesson = nhiều activity có thứ tự).
enum LessonActivityType {
  markdown
  pdf
  video
  quiz
  coding
  assignment
}

model Course {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String?
  thumbnailUrl String?
  language     CourseLanguage @default(python)
  level        CourseLevel    @default(beginner)
  status       CourseStatus   @default(draft)
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy      User            @relation("CourseCreatedBy", fields: [createdById], references: [id])
  sections       Section[]
  classCourses   ClassCourse[]
  assignments    Assignment[]
  codingProblems CodingProblem[]
  quizzes        Quiz[]

  // P5 (Gradebook & Certificate)
  certificates Certificate[]

  @@index([createdById])
  @@map("courses")
}

model Section {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
  @@map("sections")
}

model Lesson {
  id               String     @id @default(cuid())
  sectionId        String
  title            String
  order            Int
  type             LessonType @default(article)
  contentMd        String?
  videoUrl         String?
  refId            String? // soft-ref tới CodingProblem/Quiz/Assignment tùy type (thêm ở phase sau)
  estimatedMinutes Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  gates          LessonGate[]
  progress       LessonProgress[]
  assignments    Assignment[]
  codingProblems CodingProblem[]
  quizzes        Quiz[]
  comments       LessonComment[]
  activities     LessonActivity[]

  @@unique([sectionId, order])
  @@index([refId])
  @@map("lessons")
}

// P7 — một đơn vị nội dung trong bài học. `type` quyết định cột nào có nghĩa:
// markdown->contentMd, pdf->fileId, video->videoUrl (link nhúng, allowlist host),
// quiz/coding/assignment->refId (soft-ref tới Quiz/CodingProblem/Assignment, giống Lesson.refId).
model LessonActivity {
  id        String             @id @default(cuid())
  lessonId  String
  order     Int
  type      LessonActivityType
  title     String?
  contentMd String?
  fileId    String?
  videoUrl  String?
  refId     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file   File?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([lessonId, order])
  @@index([fileId])
  @@index([refId])
  @@map("lesson_activities")
}

// === Class / Cohort (T1.0) — docs/DESIGN.md §4.3 ===

enum ClassStatus {
  planning
  active
  finished
  archived
}

enum ClassMemberRole {
  student
  ta
  instructor
}

enum ClassMemberStatus {
  active
  removed
}

enum ProgressStatus {
  not_started
  in_progress
  completed
}

model Class {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      ClassStatus @default(planning)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy         User               @relation("ClassCreatedBy", fields: [createdById], references: [id])
  courses           ClassCourse[]
  members           ClassMember[]
  gates             LessonGate[]
  progress          LessonProgress[]
  submissions       Submission[]
  codingSubmissions CodingSubmission[]
  quizAttempts      QuizAttempt[]

  // P5 (Gradebook & Certificate)
  gradeItems   GradeItem[]
  certificates Certificate[]

  // P6 (Discussion)
  comments LessonComment[]

  // P10 (Gamification G2)
  xpEvents      XpEvent[]
  badgesAwarded UserBadge[]

  @@index([createdById])
  @@map("classes")
}

// Gán khóa học cho lớp.
model ClassCourse {
  id        String   @id @default(cuid())
  classId   String
  courseId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([classId, courseId])
  @@index([courseId])
  @@map("class_courses")
}

// Thành viên lớp (học viên/TA/giáo viên phụ trách). roleInClass dùng cho scope PBAC theo lớp.
model ClassMember {
  id          String            @id @default(cuid())
  classId     String
  userId      String
  roleInClass ClassMemberRole   @default(student)
  status      ClassMemberStatus @default(active)
  joinedAt    DateTime          @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
  @@map("class_members")
}

// Mở bài theo tiến độ lớp: bài chỉ mở cho lớp khi có gate isActive=true (invariant domain).
model LessonGate {
  id            String    @id @default(cuid())
  classId       String
  lessonId      String
  isActive      Boolean   @default(false)
  activatedAt   DateTime?
  activatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  class       Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activatedBy User?  @relation("GateActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  @@unique([classId, lessonId])
  @@index([lessonId])
  @@map("lesson_gates")
}

// Tiến độ học của học viên theo từng bài trong một lớp.
model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  classId     String
  status      ProgressStatus @default(not_started)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, classId])
  @@index([classId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// === Assessments — Assignment (nộp/chấm tay) (T2.0) — docs/DESIGN.md §4.4 ===

enum SubmissionType {
  text
  file
  link
}

enum SubmissionStatus {
  draft
  submitted
  graded
  returned
}

// Bài tập nộp/chấm tay. Coding autograde (§4.5) = P3, Quiz (§4.6) = P4 — KHÔNG ở đây.
model Assignment {
  id             String         @id @default(cuid())
  courseId       String
  lessonId       String?
  title          String
  descriptionMd  String?
  dueAt          DateTime?
  maxScore       Decimal        @default(100) @db.Decimal(6, 2)
  allowLate      Boolean        @default(false)
  submissionType SubmissionType @default(text)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  submissions Submission[]

  @@index([courseId])
  @@index([lessonId])
  @@map("assignments")
}

// Bài nộp của học viên trong 1 lớp. Điểm là Decimal; KHÔNG hard-delete (giữ lịch sử — soft/return).
model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  classId      String
  contentText  String?
  fileId       String? // soft-ref tới file private (StorageAdapter) — upload thật hoãn sau P2
  linkUrl      String?
  status       SubmissionStatus @default(draft)
  score        Decimal?         @db.Decimal(6, 2)
  feedbackMd   String?
  gradedById   String?
  gradedAt     DateTime?
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("SubmissionByUser", fields: [userId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, userId, classId])
  @@index([classId])
  @@index([userId])
  @@map("submissions")
}

// === Coding & Runner (T3.2) - docs/DESIGN.md 4.5, 6 ===

enum CodingLanguage {
  python
}

enum CodingDifficulty {
  easy
  medium
  hard
}

enum TestCaseKind {
  sample
  hidden
}

enum CodingSubmissionStatus {
  queued
  running
  passed
  failed
  error
}

enum TestCaseResultStatus {
  passed
  failed
  tle
  mle
  re
  ce
}

// Coding problem. Hidden testcases + solutionCode are authoring/runner only; never returned to students.
model CodingProblem {
  id            String           @id @default(cuid())
  courseId      String
  lessonId      String?
  title         String
  statementMd   String
  language      CodingLanguage   @default(python)
  starterCode   String?
  solutionCode  String?
  timeLimitMs   Int              @default(2000)
  memoryLimitMb Int              @default(128)
  difficulty    CodingDifficulty @default(easy)
  maxScore      Decimal          @default(100) @db.Decimal(6, 2)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("CodingProblemCreatedBy", fields: [createdById], references: [id])
  testCases   TestCase[]
  submissions CodingSubmission[]

  @@index([courseId])
  @@index([lessonId])
  @@index([createdById])
  @@map("coding_problems")
}

// Testcase for a coding problem. kind=hidden is never sent to students while solving.
model TestCase {
  id             String       @id @default(cuid())
  problemId      String
  name           String?
  stdin          String
  expectedStdout String
  kind           TestCaseKind @default(sample)
  weight         Decimal      @default(1) @db.Decimal(6, 2)
  order          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  problem CodingProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results TestCaseResult[]

  @@unique([problemId, order])
  @@index([problemId, kind])
  @@map("test_cases")
}

// Official code submission. Score source of truth = server-side runner; never trust client/Pyodide.
model CodingSubmission {
  id          String                 @id @default(cuid())
  problemId   String
  userId      String
  classId     String?
  sourceCode  String
  language    CodingLanguage         @default(python)
  status      CodingSubmissionStatus @default(queued)
  score       Decimal?               @db.Decimal(6, 2)
  runtimeMs   Int?
  memoryKb    Int?
  submittedAt DateTime               @default(now())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  problem CodingProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  class   Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  results TestCaseResult[]

  @@index([problemId, userId, classId])
  @@index([classId])
  @@index([status])
  @@map("coding_submissions")
}

// Per-testcase result for a submission. Never hard-delete submission/result; keep grading history.
model TestCaseResult {
  id           String               @id @default(cuid())
  submissionId String
  testCaseId   String
  status       TestCaseResultStatus
  actualStdout String?
  runtimeMs    Int?
  createdAt    DateTime             @default(now())

  submission CodingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([submissionId, testCaseId])
  @@index([testCaseId])
  @@map("test_case_results")
}

// === Quiz — autograded (T4.1) — docs/DESIGN.md §4.6 ===

enum QuizQuestionType {
  single_choice
  multiple_choice
  true_false
  short_answer
  code_fill
}

enum QuizAttemptStatus {
  in_progress
  submitted
  expired
}

// Quiz. passScore = ngưỡng đạt (Decimal). shuffle* để trộn khi trình bày cho học viên.
model Quiz {
  id               String   @id @default(cuid())
  courseId         String
  lessonId         String?
  title            String
  timeLimitSec     Int?
  attemptsAllowed  Int      @default(1)
  passScore        Decimal  @default(0) @db.Decimal(6, 2)
  shuffleQuestions Boolean  @default(false)
  shuffleOptions   Boolean  @default(false)
  published        Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy User          @relation("QuizCreatedBy", fields: [createdById], references: [id])
  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([lessonId])
  @@index([createdById])
  @@map("quizzes")
}

// Câu hỏi. correctAnswer dùng cho short_answer/code_fill; choice-based dùng QuestionOption.isCorrect.
model Question {
  id            String           @id @default(cuid())
  quizId        String
  type          QuizQuestionType @default(single_choice)
  promptMd      String
  points        Decimal          @default(1) @db.Decimal(6, 2)
  correctAnswer String?
  order         Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers QuizAnswer[]

  @@unique([quizId, order])
  @@index([quizId])
  @@map("quiz_questions")
}

// Đáp án lựa chọn. isCorrect KHÔNG BAO GIỜ gửi ra client khi làm bài (invariant P4).
model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  textMd     String
  isCorrect  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@index([questionId])
  @@map("quiz_question_options")
}

// Lượt làm bài. attemptsAllowed + timeLimit enforce ở service. KHÔNG hard-delete (giữ lịch sử điểm).
model QuizAttempt {
  id          String            @id @default(cuid())
  quizId      String
  userId      String
  classId     String?
  status      QuizAttemptStatus @default(in_progress)
  score       Decimal?          @db.Decimal(6, 2)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  class   Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  answers QuizAnswer[]

  @@index([quizId, userId, classId])
  @@index([classId])
  @@index([status])
  @@map("quiz_attempts")
}

// Đáp án 1 câu trong 1 lượt. selectedOptionIds = Json (mảng option id). Điểm chấm lại server-side.
model QuizAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionIds Json?
  textAnswer        String?
  awardedPoints     Decimal? @db.Decimal(6, 2)
  isCorrect         Boolean?
  createdAt         DateTime @default(now())

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("quiz_answers")
}

// === Gradebook & Certificate (T5.1) — docs/DESIGN.md §4.7 ===

enum GradeSourceType {
  assignment
  quiz
  coding
}

// Sổ điểm: Định nghĩa các cột điểm trong một lớp
model GradeItem {
  id         String          @id @default(cuid())
  classId    String
  sourceType GradeSourceType
  sourceId   String
  title      String
  weight     Decimal         @default(1) @db.Decimal(6, 2)
  maxScore   Decimal         @default(100) @db.Decimal(6, 2)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  entries GradeEntry[]

  @@unique([classId, sourceType, sourceId])
  @@index([classId])
  @@map("grade_items")
}

// "View vật chất" của sổ điểm — tổng hợp tự động từ Submission/QuizAttempt/CodingSubmission
model GradeEntry {
  id          String   @id @default(cuid())
  gradeItemId String
  userId      String
  score       Decimal  @db.Decimal(6, 2)
  computedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gradeItem GradeItem @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gradeItemId, userId])
  @@index([userId])
  @@map("grade_entries")
}

// Template thiết kế chứng chỉ
model CertificateTemplate {
  id               String   @id @default(cuid())
  name             String
  backgroundFileId String?
  layoutJson       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  certificates Certificate[]

  @@map("certificate_templates")
}

// Chứng chỉ đã cấp cho học viên. KHÔNG hard-delete (chỉ soft-delete / revoke).
model Certificate {
  id               String    @id @default(cuid())
  userId           String
  classId          String?
  courseId         String
  templateId       String
  serialNo         String    @unique
  verificationCode String    @unique
  finalScore       Decimal   @db.Decimal(6, 2)
  issuedAt         DateTime  @default(now())
  issuedById       String
  pdfFileId        String?
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User                @relation("CertificateForUser", fields: [userId], references: [id], onDelete: Cascade)
  class    Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  template CertificateTemplate @relation(fields: [templateId], references: [id])
  issuedBy User                @relation("CertificateIssuedBy", fields: [issuedById], references: [id])

  @@unique([userId, courseId, classId])
  @@index([userId])
  @@index([courseId])
  @@index([classId])
  @@map("certificates")
}

// Nhật ký kiểm toán hệ thống. Ghi CÙNG transaction với thao tác domain.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metaJson  Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// === Polish, Gamification, Notifications & Storage (P6) — docs/DESIGN.md §4.8, §5.4 ===

// Thông báo trong ứng dụng cho người dùng. Ghi CÙNG transaction với sự kiện domain.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String // certificate.issued, certificate.revoked, submission.graded, gate.opened, badge.awarded...
  title       String
  message     String
  payloadJson Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation("NotificationForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Sự kiện cộng điểm kinh nghiệm (XP) — append-only, idempotent (P6)
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  source    String // lesson_complete, quiz_pass, coding_pass
  // Lớp phát sinh XP. Nullable: dữ liệu trước P10 chưa gắn lớp và backfill có thể không suy ra được.
  // Bảng xếp hạng theo lớp (T10.1) BỎ QUA các bản ghi classId = null.
  classId   String?
  sourceId  String
  amount    Int
  // Lời nhắn của giáo viên khi thưởng tay (source = 'manual_award'). Nguồn tự động để NULL.
  note      String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([userId, source, sourceId])
  @@index([userId])
  // Xếp hạng tuần theo lớp: quét theo (classId, createdAt) rồi gộp theo userId.
  @@index([classId, createdAt])
  @@map("xp_events")
}

// Chuỗi ngày học liên tiếp của học viên (P6)
model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String? // 'YYYY-MM-DD'
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// Danh mục huy hiệu hệ thống (P6)
model Badge {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String
  icon         String?
  // true = CHỈ giáo viên trao tay (T10.3), tiêu chí tự động không bao giờ chạm tới.
  // Ngược lại false = huy hiệu tự động; API trao tay từ chối trao loại này.
  isManual     Boolean  @default(false)
  criteriaJson Json?
  createdAt    DateTime @default(now())

  userBadges UserBadge[]

  @@map("badges")
}

// Huy hiệu đã đạt của học viên (P6)
model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  // P10/T10.3 — chỉ có giá trị với huy hiệu trao tay. Huy hiệu tự động để NULL cả ba.
  awardedById String?
  classId     String?
  note        String?
  awardedAt   DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedBy User?  @relation("UserBadgeAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  class     Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  // Mỗi huy hiệu chỉ giữ MỘT lần. Muốn khen lại lần nữa thì thưởng XP kèm lời nhắn (không giới hạn).
  @@unique([userId, badgeId])
  @@index([userId])
  @@index([classId])
  @@map("user_badges")
}

// Quản lý file lưu trữ (private / public) (P6)
model File {
  id         String   @id @default(cuid())
  ownerId    String?
  provider   String   @default("local") // local, r2, cloudinary
  storageKey String
  fileName   String? // tên gốc lúc upload (chỉ để hiển thị — KHÔNG dùng dựng đường dẫn)
  mime       String
  sizeBytes  Int
  visibility String   @default("private") // private, public
  createdAt  DateTime @default(now())

  owner            User?            @relation("FileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lessonActivities LessonActivity[]

  @@index([ownerId])
  @@map("files")
}

// Bình luận, thảo luận trong bài học theo lớp (P6 / D5)
model LessonComment {
  id        String   @id @default(cuid())
  lessonId  String
  classId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, classId, createdAt])
  @@index([userId])
  @@map("lesson_comments")
}
